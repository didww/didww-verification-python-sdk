{
  "capturedAt": "2026-10-19",
  "source": "Captured from the verification service's own error registry and route table.",
  "baseUrls": {
    "production": "https://verification.didww.com",
    "sandbox": "https://verification-sandbox.didww.com"
  },
  "deliveryMethods": [
    "sms",
    "callout"
  ],
  "deliveryMethodsNote": "The set a client may request. A read can return a value outside it, so decode delivery_method as an open string rather than a closed enum.",
  "statuses": [
    "pending",
    "verified",
    "failed",
    "expired",
    "denied"
  ],
  "templateFallbackReasons": [
    "language_missing",
    "version_pending",
    "version_rejected",
    "audio_not_ready",
    "group_missing"
  ],
  "envelopeErrorCodes": [
    "destination_blank",
    "destination_invalid",
    "delivery_method_blank",
    "delivery_method_inclusion",
    "delivery_method_invalid",
    "languages_invalid",
    "autofill_invalid",
    "app_hash_invalid",
    "custom_too_long",
    "template_group_not_found",
    "sms_domain_not_configured",
    "code_blank",
    "destination_not_supported_for_channel",
    "code_invalid",
    "already_verified",
    "not_ready_to_report",
    "parameter_missing",
    "not_found",
    "unauthorized",
    "balance_insufficient",
    "validation_failed",
    "internal_error",
    "destination_in_cooldown",
    "rate_limit_per_ip",
    "rate_limit_failed_auth",
    "rate_limit_per_account",
    "rate_limit_public_per_account",
    "volume_limit_reached"
  ],
  "verificationErrorCodes": [
    "dispatch_failed",
    "expired",
    "too_many_attempts",
    "stale_dispatch",
    "application_deleted",
    "superseded",
    "denied_missing_callback_url",
    "denied_by_callback",
    "denied_invalid_callback_response",
    "application_paused",
    "destination_country_disabled",
    "destination_not_supported_for_channel"
  ],
  "verificationErrorCodesNote": "destination_not_supported_for_channel is an outcome code; it stays in the envelope list for compatibility. stale_dispatch is no longer sent; it is reported as dispatch_failed and kept only so existing matches still type-check.",
  "routes": [
    {
      "name": "startVerification",
      "methods": [
        "POST"
      ],
      "path": "/api/v1/verifications",
      "successStatus": 201,
      "errorStatuses": [
        400,
        401,
        402,
        422,
        429,
        500
      ]
    },
    {
      "name": "getVerification",
      "methods": [
        "GET"
      ],
      "path": "/api/v1/verifications/{id}",
      "successStatus": 200,
      "errorStatuses": [
        401,
        404,
        429,
        500
      ]
    },
    {
      "name": "reportVerification",
      "methods": [
        "PUT",
        "PATCH"
      ],
      "path": "/api/v1/verifications/{id}",
      "successStatus": 200,
      "errorStatuses": [
        400,
        401,
        404,
        422,
        429,
        500
      ],
      "notes": "PUT and PATCH are the same operation, not two."
    },
    {
      "name": "getVerificationByNumber",
      "methods": [
        "GET"
      ],
      "path": "/api/v1/verifications/by_number/{number}",
      "successStatus": 200,
      "errorStatuses": [
        401,
        404,
        429,
        500
      ]
    },
    {
      "name": "reportVerificationByNumber",
      "methods": [
        "PUT",
        "PATCH"
      ],
      "path": "/api/v1/verifications/by_number/{number}",
      "successStatus": 200,
      "errorStatuses": [
        400,
        401,
        404,
        422,
        429,
        500
      ]
    }
  ],
  "authSchemes": {
    "public": {
      "header": "Authorization: Application <key>"
    },
    "basic": {
      "header": "Authorization: Basic base64(key:secret)"
    },
    "application": {
      "header": "Authorization: Application <key>:<signature>, plus x-timestamp"
    },
    "ranking": [
      "public",
      "basic",
      "application"
    ]
  },
  "signing": {
    "algorithm": "HMAC-SHA256",
    "signatureEncoding": "standard base64, padded",
    "keyDerivation": "base64 decode of the application secret; the raw bytes are the key",
    "stringToSign": [
      "<HTTP-METHOD>",
      "<CONTENT-MD5>",
      "<CONTENT-TYPE>",
      "x-timestamp:<TIMESTAMP>",
      "<PATH>"
    ],
    "joinedWith": "\n",
    "contentMd5EmptyWhen": "the body is absent, empty, or whitespace only",
    "path": "the request-target path, undecoded, query excluded",
    "bodylessRequestSendsNoContentTypeHeader": true,
    "replayWindowSeconds": 300
  },
  "callback": {
    "signedPath": "the path of the REGISTERED callback URL, query excluded",
    "bareOriginSignsEmptyString": true,
    "expectedResponse": {
      "status": "2xx",
      "body": {
        "action": "allow | deny"
      }
    },
    "retries": 0
  },
  "constraints": {
    "destinationNormalization": "every non-digit is stripped, the leading '+' included",
    "generatedCodeLength": {
      "min": 4,
      "max": 8,
      "default": 6
    },
    "codePlaceholder": "{{CODE}}",
    "languageFallback": "en-US",
    "reportAttemptsMax": 3
  }
}
