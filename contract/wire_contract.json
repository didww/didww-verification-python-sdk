    "sandbox": "https://verification-sandbox.didww.com"
  },
  "deliveryMethods": [
    "sms",
    "callout"
  ],
  "deliveryMethodsNote": "The set a client may request. A read can return a value outside it, so decode delivery_method as an open string rather than a closed enum.",
  "statuses": [
    "pending",
    "verified",
    "failed",
    "expired",
    "denied"
  ],
  "envelopeErrorCodes": [
    "destination_blank",
